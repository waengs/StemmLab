{
  "expo": {
    "name": "StemmLab",
    "slug": "StemmLab",
    "version": "1.0.0",
    "icon": "./assets/images/logo.jpeg",
    "extra": {
      "eas": {
        "projectId": "13f75974-3f0a-453a-a6e8-f732bebdba28"
      }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "stemmlab",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.waengs.StemmLab",
      "googleServicesFile": "./google-services.json"
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-localization",
      "expo-sqlite",
      "expo-video",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow STEMM Lab to use your location to map sound pollution data."
        }
      ],
      "expo-audio"
    ]
  }
}
