# Copy to .env (or use the .env file in the repo root) and fill values after =
# Restart Expo after changes: npx expo start -c

# Firebase — Console → Project settings → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — Dashboard → Settings → Upload → unsigned upload preset
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
EXPO_PUBLIC_CLOUDINARY_SLOWMO_FOLDER=stemmlab/slow-mo
EXPO_PUBLIC_CLOUDINARY_SENSOR_LOGS_FOLDER=stemmlab/sensor-logs
EXPO_PUBLIC_CLOUDINARY_FORUM_FOLDER=stemmlab/forum

# AdMob — optional; omit interstitial unit to use Google test ads in custom builds
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
