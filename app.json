{
  "expo": {
    "name": "StemmLab",
    "slug": "StemmLab",
    "version": "2.0.0",
    "icon": "./assets/images/logo.jpeg",
    "extra": {
      "eas": {
        "projectId": "5a660196-e9a2-44d9-9761-1b78794f910a"
      }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "stemmlab",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "package": "com.waengs.StemmLab",
      "googleServicesFile": "./google-services.json"
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-localization",
      "expo-sqlite",
      "expo-video",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Stemm Lab to use your location to map sound pollution data."
        }
      ],
      "expo-audio"
    ]
  }
}
